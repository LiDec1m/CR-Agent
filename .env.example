# ========== LLM 配置 ==========
# 美团 AIGC 平台 (FRIDAY 统一接口)
OPENAI_API_KEY=你的AppId
OPENAI_API_BASE=https://aigc.sankuai.com/v1/openai/native
MODEL_NAME=deepseek-v4-pro

# ========== Embedding 配置 ==========
# 注意：AIGC 平台可能不支持 embedding 模型
# 如果不需要 RAG 功能，可以留空
EMBEDDING_MODEL=text-embedding-3-small

# ========== 数据库配置 ==========
DB_PATH=data/risk_agent.db
